# Copy to .env; replace the example URL with your private Tailscale Serve HTTPS URL.
# No Ollama installation is required on the inference client.
HPC_LLM_PROVIDER=ollama
HPC_OLLAMA_BASE_URL=https://inference.example.test
HPC_OLLAMA_MODEL=qwen3.5:9b-q4_K_M
# Required for the configured Tailscale Serve -> local Ollama routing.
# Leave empty for a direct local Ollama connection.
HPC_OLLAMA_HOST_HEADER=localhost:11434
HPC_OLLAMA_TIMEOUT=180
HPC_OLLAMA_KEEP_ALIVE=15m
# Keep context bounded on an 8 GB GPU; it is never increased automatically.
HPC_OLLAMA_NUM_CTX=4096
HPC_OLLAMA_NUM_PREDICT=2048
HPC_OLLAMA_TEMPERATURE=0.2
# true/false; null omits the parameter and uses the model default.
HPC_OLLAMA_THINK=false
HPC_HISTORY_DIR=experiments
